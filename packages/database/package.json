{
  "name": "@assetflow/database",
  "version": "1.0.0",
  "description": "Database configuration and Prisma schema for AssetFlow AI",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc",
    "dev": "prisma generate && tsc --watch",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:pull": "prisma db pull",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:seed": "ts-node prisma/seed.ts",
    "db:format": "prisma format",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@prisma/client": "^7.9.1",
    "prisma": "^7.9.1",
    "@assetflow/shared-types": "*"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2"
  },
  "keywords": [
    "database",
    "prisma",
    "postgresql",
    "assetflow"
  ],
  "author": "AssetFlow AI",
  "license": "MIT"
}