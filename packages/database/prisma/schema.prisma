// ============================================
// FIXES & REFINEMENTS APPLIED TO CORE MODELS
// ============================================

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  firstName         String
  lastName          String
  displayName       String?
  phone             String?
  role              UserRole          @default(INVESTOR)
  status            UserStatus        @default(ACTIVE)
  organizationId    String
  walletAddress     String?
  walletType        String?
  emailVerified     Boolean           @default(false)
  mfaEnabled        Boolean           @default(false)
  mfaMethod         MFAMethod?
  mfaSecret         String?
  passwordHash      String
  lastLoginAt       DateTime?
  preferences       Json              @default("{}")
  avatarUrl         String?
  timezone          String            @default("UTC")
  language          String            @default("en")
  stripeCustomerId  String?           @unique // REQUIRED FOR SAAS PAYMENTS AND CARDS
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  // Relations
  organization      Organization      @relation(fields: [organizationId], references: [id])
  sessions          Session[]
  refreshTokens     RefreshToken[]
  kycChecks         KycCheck[]
  amlChecks         AmlCheck[]
  assets            Asset[]
  orders            Order[]
  payments          Payment[]
  wallets           Wallet[]
  tokenHolders      TokenHolder[]
  activities        Activity[]
  notifications     Notification[]
  auditLogs         AuditLog[]        @relation("UserAuditLogs")
  passwordResets    PasswordReset[]
  invites           UserInvite[]      @relation("InvitedUser")
  sentInvites       UserInvite[]      @relation("InvitedBy")
  apiKeys           ApiKey[]
  
  // Backward relations matching Trade and Position requirements
  tradesAsBuyer     Trade[]           @relation("BuyerTrades")
  tradesAsSeller    Trade[]           @relation("SellerTrades")
  positions         Position[]

  @@index([organizationId])
  @@index([email])
  @@index([status])
  @@index([walletAddress])
  @@index([deletedAt])
}

// Ensure the Trade model links up explicitly with these User back-relations
model Trade {
  id               String           @id @default(uuid())
  orderId          String
  assetId          String
  buyerId          String
  sellerId         String
  price            Decimal          @db.Decimal(20, 2)
  amount           BigInt
  total            Decimal          @db.Decimal(20, 2)
  fee              Decimal          @db.Decimal(20, 2)
  feeCurrency      String           @default("USD")
  feeRate          Decimal          @db.Decimal(5, 4) @default(0.0025)
  executedAt       DateTime         @default(now())
  settlementStatus SettlementStatus @default(PENDING)
  settlementDate   DateTime?
  transactionHash  String?

  order            Order            @relation(fields: [orderId], references: [id])
  asset            Asset            @relation(fields: [assetId], references: [id])
  buyer            User             @relation("BuyerTrades", fields: [buyerId], references: [id])
  seller           User             @relation("SellerTrades", fields: [sellerId], references: [id])

  @@index([orderId])
  @@index([assetId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([executedAt])
  @@index([settlementStatus])
}

// Appending RegulatoryReport back-relation to Organization
model Organization {
  id                String                @id @default(uuid())
  name              String
  legalName         String
  type              OrganizationType      @default(OTHER)
  status            OrganizationStatus    @default(ACTIVE)
  registrationNumber String               @unique
  taxId             String
  country           String
  city              String
  address           String
  postalCode        String
  website           String?
  contactEmail      String
  contactPhone      String
  settings          Json                  @default("{}")
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  deletedAt         DateTime?

  // Relations
  users             User[]
  assets            Asset[]
  complianceCases   ComplianceCase[]
  settingsConfig    OrganizationSetting[]
  invites           UserInvite[]
  apiKeys           ApiKey[]
  regulatoryReports RegulatoryReport[]    // FIXED BACK-RELATION

  @@index([name])
  @@index([status])
  @@index([type])
  @@index([deletedAt])
}