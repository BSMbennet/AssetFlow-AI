# ============================================
# ASSETFLOW AI - Environment Variables
# ============================================

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
PYTHON_VERSION=3.11
LOG_LEVEL=info
DEBUG=false

# ============================================
# DATABASE
# ============================================
DB_PASSWORD=secure_password_here
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=assetflow
DB_DATABASE=assetflow
DATABASE_URL=postgresql://assetflow:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_DATABASE}

# ============================================
# REDIS
# ============================================
REDIS_PASSWORD=redis_secure_password
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}

# ============================================
# RABBITMQ
# ============================================
RABBITMQ_USER=assetflow
RABBITMQ_PASSWORD=rabbitmq_secure_password
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:${RABBITMQ_PORT}

# ============================================
# JWT
# ============================================
JWT_SECRET=change_this_to_a_strong_secret
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# ============================================
# API
# ============================================
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000,https://assetflow.ai

# ============================================
# WEB
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_AI_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_ENVIRONMENT=development

# ============================================
# AI SERVICE
# ============================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0

# ============================================
# BLOCKCHAIN
# ============================================
WEB3_PROVIDER=http://hardhat:8545
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NETWORK=localhost
CHAIN_ID=1337
PRIVATE_KEY=your_private_key_here

# ============================================
# AWS
# ============================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET=assetflow-uploads
AWS_S3_ENDPOINT=

# ============================================
# EMAIL
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@assetflow.ai

# ============================================
# MONITORING
# ============================================
SENTRY_DSN=your_sentry_dsn
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
ENABLE_METRICS=true
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_WHITELABEL=false
ENABLE_MULTI_CHAIN=true
ENABLE_AI_COPILOT=true
ENABLE_WEBHOOKS=true
ENABLE_BATCH_PROCESSING=true